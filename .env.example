# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works. Free / open-model options (pick ONE):
#
# Groq (free tier, Llama / Qwen open models):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant          # or llama-3.3-70b-versatile (lower daily token quota)
# OpenRouter (free models end with ":free"):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen-2.5-72b-instruct:free
# SiliconFlow (works well from mainland China; Qwen2.5-7B is free):
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Local Ollama (no key, needs ~8 GB RAM):  ollama pull qwen2.5:7b
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_PROVIDER=mock   # force mock mode (no LLM calls)
